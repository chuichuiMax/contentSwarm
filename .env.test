# 复制为服务器上的私有部署环境文件（例如 /srv/contentswarm/config/.env.source），
# 填写后通过 docker compose --env-file <该文件> -f docker-compose.source.yml 调用。
# 不要提交真实密钥；${CONFIG_ROOT}/.env.prod 继续保存完整的业务配置。

# Compose 与宿主机绝对目录
COMPOSE_PROJECT_NAME=contentswarm-source
APP_NETWORK_NAME=contentswarm-source_app-network
SOURCE_ROOT=/dangjia/project/contentswarm/repo
CONFIG_ROOT=/dangjia/project/contentswarm/config
RELEASE_ROOT=/dangjia/project/contentswarm/releases
DATA_ROOT=/dangjia/project/contentswarm/data
CACHE_ROOT=/dangjia/project/contentswarm/cache

# 由运维预先拉取并固定版本的无业务源码基础镜像；生产环境推荐使用 digest。
YUXI_API_RUNTIME_IMAGE=harbor.dangjia.com/base/contentswarm-api-runtime:1.0.0
YUXI_SANDBOX_RUNTIME_IMAGE=harbor.dangjia.com/base/contentswarm-sandbox-runtime:1.0.0
RELEASE_BUILDER_IMAGE=harbor.dangjia.com/base/contentswarm-release-builder:1.0.0
HYCANVAS_RUNTIME_IMAGE=harbor.dangjia.com/base/contentswarm-hycanvas-runtime:1.0.0
NGINX_RUNTIME_IMAGE=harbor.dangjia.com/base/nginx:1.31.2-alpine
SANDBOX_IMAGE=harbor.dangjia.com/base/all-in-one-sandbox:1.11.0

# 对外地址与端口
CONTENTSWARM_PUBLIC_URL=http://10.10.10.52:8090
HYCANVAS_PUBLIC_URL=http://10.10.10.52:8005
WEB_HOST_PORT=8090
HYCANVAS_PORT=8005
VITE_BASE_PATH=/boyun/
HYCANVAS_COOKIE_SECURE=false

# 必填生产密钥：必须替换为空间独立的随机值，不得沿用示例或公开默认密码。
JWT_SECRET_KEY=1e7bac521ef7c8082f814114dd784c109141ca1750b19b47787bda1336a5f5ae
YUXI_INSTANCE_ID=8c5b1e7f55a5134b152afbc19b804da4af2ead7c4a622c03871e20405f1f8c1c
POSTGRES_PASSWORD=2c0764e8a4442c38a92a165b79ed06d130c3e9db49392aedcabeac2a6fe5b454
NEO4J_PASSWORD=2534ba58300b0459f433c98f1dca24741d776cb3aa5094c53e91f1a05860170e
MINIO_ACCESS_KEY=2416aa75dbbaf814ea4b22c7
MINIO_SECRET_KEY=be11dd2c9c237bec4b225141
HYCANVAS_DB_PASSWORD=94d96212590861db05713be9
HYCANVAS_JWT_SECRET=e09c1f2fe780645fe26a0b6c
# HyCanvas 集成密钥必须使用 hyk_ 前缀。
HYCANVAS_API_KEY=hyk_254ae1169a626ae24f5a85bef025a9481233df9b2955ba6a8509d06073445f51
HYCANVAS_WORKSPACE_ID=069c79ff-18d8-496d-9eb1-5e0088e61522
XHS_GATEWAY_TOKEN=e52e03fa0614493750d29f420e6fdaf84e403a5804b2ed1725673d4296d2e641

# 可选基础设施与运行参数
POSTGRES_USER=postgres
POSTGRES_DB=yuxi
NEO4J_USERNAME=neo4j
HYCANVAS_DB_USER=hycanvas
HYCANVAS_DB_NAME=hycanvas
HYCANVAS_COOKIE_SECURE=true
XHS_GATEWAY_HEADLESS=true
XHS_GATEWAY_SHM_SIZE=1gb
XHS_GATEWAY_MEMORY_LIMIT=4g
TZ=Asia/Shanghai

# 重型 GPU 服务仅在 --profile all 时启动；请替换为服务器已有的固定镜像版本。
MINERU_IMAGE=mineru-vllm:0.7.0
PADDLEX_IMAGE=paddlex:0.7.0
MINERU_HOST_PORT=30001

# Sandbox 创建的业务容器需要加入与 Compose 相同的网络。
SANDBOX_DOCKER_NETWORK=contentswarm-source_app-network
SANDBOX_DOCKER_THREADS_HOST_PATH=/dangjia/data/contentSwarm/data/yuxi/threads
