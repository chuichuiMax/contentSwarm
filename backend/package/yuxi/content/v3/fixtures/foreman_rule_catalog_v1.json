  },
  "methods": [
    {
      "code": "FRM01",
      "name": "价格营销型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "以真实价格或报价口径吸引注意，再解释费用构成、服务边界和工长价值。",
      "suitable_scenes": ["施工报价", "半包报价", "毛坯房装修"],
      "sentence_patterns": ["{location}{business}，这份{quote_type}先把钱花在哪讲清楚"],
      "tag_schema": {"business_mode": "A", "evidence": ["真实报价", "报价口径"]},
      "variable_schema": ["location", "product", "price"],
      "risk_rules": ["价格必须来自用户确认或已核验资料", "必须说明报价类型和包含范围", "不得把预算写成成交或结算价"]
    },
    {
      "code": "FRM02",
      "name": "案例故事型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "从真实业主问题和需求出发，用解决过程、施工证据与结果建立信任。",
      "suitable_scenes": ["旧房改造", "老破小", "局部翻新", "典型案例", "日常工作"],
      "sentence_patterns": ["这次{location}{house}，先解决的是{needs}"],
      "tag_schema": {"business_mode": "B", "evidence": ["案例背景", "施工过程", "结果"]},
      "variable_schema": ["location", "product", "pain", "process", "result"],
      "risk_rules": ["不得虚构业主、需求、对话、过程或反馈", "计划中的结果不得写成已经完成"]
    },
    {
      "code": "FRM03",
      "name": "用户痛点型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "先回应装修业主当下最担心的问题，再用真实案例、方案和报价降低决策风险。",
      "suitable_scenes": ["担心增项", "怕乱拆乱改", "联系不到工长", "预算有限"],
      "sentence_patterns": ["如果你最担心{pain}，先看方案和报价是不是对得上"],
      "tag_schema": {"business_mode": "C", "evidence": ["痛点", "解决方案", "真实报价"]},
      "variable_schema": ["pain", "product", "price", "advantages"],
      "risk_rules": ["不得制造虚假恐慌", "痛点必须与当前业务场景一致"]
    },
    {
      "code": "FRM04",
      "name": "工艺专业型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "围绕一个具体施工问题，给出可核验的标准、现场证据与验收方法。",
      "suitable_scenes": ["卫生间", "防水", "水电", "贴砖", "油漆"],
      "sentence_patterns": ["{project}做得对不对，现场主要看{process}"],
      "tag_schema": {"business_mode": "D", "evidence": ["施工标准", "现场实拍", "验收方式"]},
      "variable_schema": ["product", "process"],
      "risk_rules": ["施工标准必须来自核验资料", "图片只能证明画面中可见的空间、阶段和工种"]
    },
    {
      "code": "FRM05",
      "name": "工长自荐型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "用真实身份、做事方式和可核验证据介绍工长，每篇只选择与当前用户顾虑相关的二至三项优势。",
      "suitable_scenes": ["自我介绍", "本地获客", "服务边界", "日常工作"],
      "sentence_patterns": ["我是{location}做{business}的{identity}"],
      "tag_schema": {"business_mode": "E", "persona_layers": ["身份", "价值", "证据"]},
      "variable_schema": ["location", "persona_fact", "advantages"],
      "risk_rules": ["身份、经验和案例必须真实", "单篇最多使用三项相关优势", "不得自造质保、响应时效或服务承诺"]
    },
    {
      "code": "FRM06",
      "name": "项目单价型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "按具体施工项目展示真实单价、适用条件和包含范围，帮助业主判断报价。",
      "suitable_scenes": ["人工工价行情", "单项人工价格"],
      "sentence_patterns": ["{location}{project}怎么收费，先看单价和包含范围"],
      "tag_schema": {"business_mode": "F", "price_basis": ["standard_unit_price", "project_quote"]},
      "variable_schema": ["location", "product", "price"],
      "risk_rules": ["标准单价必须明确标注为参考", "标准单价不得冒充本案成交或结算价格", "不得倒推工程量或小计"]
    },
    {
      "code": "FRM07",
      "name": "单价+面积型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "在面积与单价均为同一真实口径时展示计算过程、重点项目和总价。",
      "suitable_scenes": ["卫生间", "厨房", "局部翻新", "按面积计价"],
      "sentence_patterns": ["{location}{area}{business}，按{price}计算"],
      "tag_schema": {"business_mode": "G", "calculation": "deterministic"},
      "variable_schema": ["location", "quantity", "product", "price"],
      "risk_rules": ["面积、单价和总价必须是同一项目口径", "计算不一致时阻断发布", "标准单价不可直接乘以项目面积推导成交总价"]
    },
    {
      "code": "FRM08",
      "name": "工种总价型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "以真实总价为钩子，按工种说明包含项和预算分配。",
      "suitable_scenes": ["半包", "硬装", "全屋基础施工"],
      "sentence_patterns": ["{location}{area}{business}，各工种总价这样分"],
      "tag_schema": {"business_mode": "H", "evidence": ["工种总价", "包含项"]},
      "variable_schema": ["location", "quantity", "product", "price"],
      "risk_rules": ["各工种总价必须来自同一真实报价", "合计不一致时阻断发布", "不得补造未提供的分项"]
    },
    {
      "code": "FRM09",
      "name": "人工+辅材型",
      "method_type": "core",
      "industry_scope": ["decoration"],
      "principle": "把人工与辅材拆开说明，再按工种解释花费原因和透明服务价值。",
      "suitable_scenes": ["半包", "硬装", "真实账单"],
      "sentence_patterns": ["这份{business}总价里，人工和辅材分别花在哪"],
      "tag_schema": {"business_mode": "I", "evidence": ["人工合计", "辅材合计", "工种拆分"]},
      "variable_schema": ["product", "price", "process"],
      "risk_rules": ["人工、辅材和总价必须来自同一真实报价", "合计不一致时阻断发布", "透明优势必须有服务证据"]
    }
  ],
