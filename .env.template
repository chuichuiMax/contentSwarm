# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ

# image2 封面生成中转站（Base URL 不包含具体接口路径）
IMAGE2_BASE_URL=
IMAGE2_API_KEY=
# 必须填写中转站模型列表中的图片模型 ID（例如 gpt-image-2），不要填写 high 等质量参数
IMAGE2_MODEL=
# IMAGE2_SUBMIT_PATH=/images/generations
# IMAGE2_EDIT_PATH=/images/edits
# SiliconFlow 图像编辑使用同一个 generations 端点和 JSON 图片字段：
# IMAGE2_EDIT_PATH=/images/generations
# IMAGE2_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509
# IMAGE2_EDIT_REQUEST_FORMAT=siliconflow_json
# IMAGE2_STATUS_PATH=/images/generations/{task_id}
# IMAGE2_TIMEOUT_SECONDS=120
# IMAGE2_POLL_INTERVAL_SECONDS=2
# IMAGE2_POLL_TIMEOUT_SECONDS=900
# IMAGE2_MAX_CONCURRENT=1
# IMAGE2_SEND_RESPONSE_FORMAT=false
# CONTENT_COVER_BUCKET=content-covers
TAVILY_API_KEY=  # 获取搜索服务的 api key 请访问 https://app.tavily.com/

# JWT 安全配置：首次部署请生成随机值，初始化脚本会在留空时自动生成
YUXI_ENV=development
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=

# 获客小程序微信登录（生产必填；未配置时微信授权登录返回 503）
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

