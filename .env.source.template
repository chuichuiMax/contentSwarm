# 复制为服务器上的私有部署环境文件（例如 /srv/contentswarm/config/.env.source），
# 填写后通过 docker compose --env-file <该文件> -f docker-compose.source.yml 调用。
# 不要提交真实密钥；${CONFIG_ROOT}/.env.config 继续保存完整的业务配置。

# Compose 与宿主机绝对目录
COMPOSE_PROJECT_NAME=contentswarm-source
APP_NETWORK_NAME=contentswarm-source_app-network
SOURCE_ROOT=/srv/contentswarm/repo
CONFIG_ROOT=/srv/contentswarm/config
RELEASE_ROOT=/srv/contentswarm/releases
DATA_ROOT=/srv/contentswarm/data
CACHE_ROOT=/srv/contentswarm/cache

# 由运维预先拉取并固定版本的无业务源码基础镜像；生产环境推荐使用 digest。
YUXI_API_RUNTIME_IMAGE=registry.example.com/contentswarm/api-runtime:1.0.0
YUXI_SANDBOX_RUNTIME_IMAGE=registry.example.com/contentswarm/sandbox-runtime:1.0.0
RELEASE_BUILDER_IMAGE=registry.example.com/contentswarm/release-builder:1.0.0
HYCANVAS_RUNTIME_IMAGE=registry.example.com/contentswarm/hycanvas-runtime:1.0.0
NGINX_RUNTIME_IMAGE=nginx:1.31.2-alpine@sha256:35cd77497979abe70dc8d26f5ae60811eea233a2eb5dc03c2ee30972caeb303e
SANDBOX_IMAGE=registry.example.com/contentswarm/agent-sandbox:1.0.0

# 对外地址与端口
CONTENTSWARM_PUBLIC_URL=https://contentswarm.example.com
HYCANVAS_PUBLIC_URL=https://contentswarm.example.com/hycanvas
WEB_HOST_PORT=8090
HYCANVAS_PORT=8005
VITE_BASE_PATH=/boyun/

# 必填生产密钥：必须替换为空间独立的随机值，不得沿用示例或公开默认密码。
JWT_SECRET_KEY=
YUXI_INSTANCE_ID=
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
HYCANVAS_DB_PASSWORD=
HYCANVAS_JWT_SECRET=
# HyCanvas 集成密钥必须使用 hyk_ 前缀。
HYCANVAS_API_KEY=
HYCANVAS_WORKSPACE_ID=
XHS_GATEWAY_TOKEN=

# 可选基础设施与运行参数
POSTGRES_USER=postgres
POSTGRES_DB=yuxi
NEO4J_USERNAME=neo4j
HYCANVAS_DB_USER=hycanvas
HYCANVAS_DB_NAME=hycanvas
HYCANVAS_COOKIE_SECURE=true
XHS_GATEWAY_HEADLESS=true
XHS_GATEWAY_SHM_SIZE=1gb
XHS_GATEWAY_MEMORY_LIMIT=4g
TZ=Asia/Shanghai

# 重型 GPU 服务仅在 --profile all 时启动；请替换为服务器已有的固定镜像版本。
MINERU_IMAGE=mineru-vllm:0.7.0
PADDLEX_IMAGE=paddlex:0.7.0
MINERU_HOST_PORT=30001

# Sandbox 创建的业务容器需要加入与 Compose 相同的网络。
SANDBOX_DOCKER_NETWORK=contentswarm-source_app-network
SANDBOX_DOCKER_THREADS_HOST_PATH=/srv/contentswarm/data/yuxi/threads
